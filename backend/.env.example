APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sauvegarde automatique quotidienne (base de données + documents, voir
# config/backup.php et routes/console.php) — chemin HORS du dossier du projet
# où stocker les archives locales de sauvegarde. À renseigner explicitement en
# production (le repli par défaut ne convient qu'au poste Windows local) ; ex.
# sur le VPS Linux : /var/backups/his-archives (le créer et le rendre
# accessible en écriture à l'utilisateur qui exécute php-fpm avant le premier
# passage de la tâche planifiée).
BACKUP_LOCAL_PATH=
# Adresse qui reçoit les alertes en cas d'échec/anomalie de sauvegarde — sans
# ça, un échec de sauvegarde reste invisible.
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Disque utilisé pour stocker les documents archivés. "sftp" en production (voir
# les identifiants SFTP_* ci-dessous). Mettre "local" si aucun serveur SFTP n'est
# disponible (développement local, démo).
DOCUMENT_STORAGE_DISK=sftp

SFTP_HOST=sftp.example.com
SFTP_USERNAME=username
SFTP_PASSWORD=password
SFTP_PORT=22
SFTP_ROOT=/path/to/root

SMB_HOST=smb.example.com
SMB_USERNAME=username
SMB_PASSWORD=password
SMB_WORKGROUP=WORKGROUP
SMB_SHARE=share
SMB_PATH_PREFIX=path/to/share

# Clé API Google Gemini pour l'assistance IA sur les documents (lecture/OCR,
# suggestion de titre, recherche assistée, suggestion de service de transmission).
# Laisser vide désactive proprement ces fonctionnalités (repli sur la saisie
# manuelle) — aucune n'est bloquante si la clé est absente ou l'appel échoue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Serveur OnlyOffice (édition de documents Word directement dans le navigateur)
# — conteneur Docker séparé sur le même serveur, voir la doc de déploiement.
# ONLYOFFICE_URL est l'adresse publique du proxy nginx vers ce conteneur ;
# ONLYOFFICE_JWT_SECRET doit être IDENTIQUE au secret JWT configuré côté
# conteneur OnlyOffice (JWT_SECRET dans ses variables d'environnement) —
# sans ça les deux ne se font pas confiance et l'éditeur refuse de s'ouvrir.
ONLYOFFICE_URL=https://hisdocs.com/onlyoffice
ONLYOFFICE_JWT_SECRET=
